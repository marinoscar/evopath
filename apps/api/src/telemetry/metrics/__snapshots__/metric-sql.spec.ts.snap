exports[`metric catalog SQL table uptimeTargets matches the snapshot without and with filters 1`] = `"SELECT 'durationMs' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, max("greptime_value") AS v FROM "httpcheck_duration_milliseconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "http_url" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'tlsDaysLeft' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, min("greptime_value") AS v FROM "httpcheck_tls_cert_remaining_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "http_url" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 101"`;

exports[`metric catalog SQL table uptimeTargets matches the snapshot without and with filters 2`] = `"SELECT 'durationMs' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, max("greptime_value") AS v FROM "httpcheck_duration_milliseconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" = 'vm''1' AND "http_url" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'tlsDaysLeft' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, min("greptime_value") AS v FROM "httpcheck_tls_cert_remaining_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" = 'vm''1' AND "http_url" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 101"`;

exports[`metric catalog SQL uptime status and errors match the snapshot (0) 1`] = `"SELECT k, max(ts) AS last_at, max(CASE WHEN ok = 1 THEN ts END) AS last_ok_at, count(*) AS checks, sum(ok) AS ok_checks, last_value(ok ORDER BY ts) AS ok_now, last_value(code ORDER BY ts) AS code FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, max(CASE WHEN "http_status_class" = '2xx' AND "greptime_value" = 1 THEN 1 ELSE 0 END) AS ok, max(CASE WHEN "greptime_value" = 1 THEN "http_status_code" END) AS code FROM "httpcheck_status" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY ts, k) GROUP BY k ORDER BY k LIMIT 51"`;

exports[`metric catalog SQL uptime status and errors match the snapshot (0) 2`] = `"SELECT "http_url" AS k, count(*) AS errors, substr(last_value("error_message" ORDER BY "greptime_timestamp"), 1, 200) AS message, max("greptime_timestamp") AS at FROM "httpcheck_error" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY k ORDER BY k LIMIT 51"`;

exports[`metric catalog SQL uptime status and errors match the snapshot (1) 1`] = `"SELECT k, max(ts) AS last_at, max(CASE WHEN ok = 1 THEN ts END) AS last_ok_at, count(*) AS checks, sum(ok) AS ok_checks, last_value(ok ORDER BY ts) AS ok_now, last_value(code ORDER BY ts) AS code FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, max(CASE WHEN "http_status_class" = '2xx' AND "greptime_value" = 1 THEN 1 ELSE 0 END) AS ok, max(CASE WHEN "greptime_value" = 1 THEN "http_status_code" END) AS code FROM "httpcheck_status" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" = 'vm''1' GROUP BY ts, k) GROUP BY k ORDER BY k LIMIT 51"`;

exports[`metric catalog SQL uptime status and errors match the snapshot (1) 2`] = `"SELECT "http_url" AS k, count(*) AS errors, substr(last_value("error_message" ORDER BY "greptime_timestamp"), 1, 200) AS message, max("greptime_timestamp") AS at FROM "httpcheck_error" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" = 'vm''1' GROUP BY k ORDER BY k LIMIT 51"`;

exports[`metric catalog SQL verdict probes match the snapshot 1`] = `
{
  "database": "SELECT 'backends' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "instance" AS k, sum("greptime_value") AS v FROM "postgresql_backends" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "instance" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'max' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "instance" AS k, max("greptime_value") AS v FROM "postgresql_connection_max" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "instance" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY m, k LIMIT 401",
  "host": "SELECT 'disk' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_utilization_ratio" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'memory' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "host_name" AS k, max("greptime_value") AS v FROM "system_memory_utilization_ratio" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'used' AND "host_name" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY m, k LIMIT 401",
  "nodes": "SELECT 'health' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "health" AS k, sum("greptime_value") AS v FROM "app_nodes_count" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "health" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'noEligible' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_nodes_types_no_eligible_node" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY m, k LIMIT 401",
  "pipeline": "SELECT 'failed' AS m, k, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "exporter" AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "exporter", "host_name", "instance", "job", "service_instance_id", "service_name", "service_version" ORDER BY "greptime_timestamp") AS p FROM "otelcol_exporter_send_failed_metric_points_total" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "exporter" IS NOT NULL) GROUP BY k UNION ALL SELECT 'sent' AS m, k, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "exporter" AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "exporter", "host_name", "instance", "job", "service_instance_id", "service_name", "service_version" ORDER BY "greptime_timestamp") AS p FROM "otelcol_exporter_sent_metric_points_total" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "exporter" IS NOT NULL) GROUP BY k ORDER BY m, k LIMIT 401",
  "queue": "SELECT 'oldest' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_oldest_pending_age_seconds" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'backup' AS m, k, max(v) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, '' AS k, max("greptime_value") AS v FROM "app_backup_last_success_timestamp_seconds" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY ts, k) GROUP BY k ORDER BY m, k LIMIT 401",
  "tls": "SELECT 'tls' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, min("greptime_value") AS v FROM "httpcheck_tls_cert_remaining_seconds" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "http_url" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY m, k LIMIT 201",
  "uptime": "SELECT k, max(ts) AS last_at, max(CASE WHEN ok = 1 THEN ts END) AS last_ok_at, count(*) AS checks, sum(ok) AS ok_checks, last_value(ok ORDER BY ts) AS ok_now, last_value(code ORDER BY ts) AS code FROM (SELECT "greptime_timestamp" AS ts, "http_url" AS k, max(CASE WHEN "http_status_class" = '2xx' AND "greptime_value" = 1 THEN 1 ELSE 0 END) AS ok, max(CASE WHEN "greptime_value" = 1 THEN "http_status_code" END) AS code FROM "httpcheck_status" WHERE "greptime_timestamp" >= '2026-09-27T21:50:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY ts, k) GROUP BY k ORDER BY k LIMIT 201",
}
`;
