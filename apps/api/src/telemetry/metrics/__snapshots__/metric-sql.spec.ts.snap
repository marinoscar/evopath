exports[`metric catalog SQL table noEligibleNodeTypes matches the snapshot without and with filters 1`] = `"SELECT 'noEligibleNode' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_nodes_types_no_eligible_node" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 51"`;

