exports[`metric catalog SQL table filesystems matches the snapshot without and with filters 1`] = `"SELECT 'utilizationPct' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_utilization_ratio" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'usedBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_usage_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'used' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'freeBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_usage_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'free' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 151"`;

exports[`metric catalog SQL table filesystems matches the snapshot without and with filters 2`] = `"SELECT 'utilizationPct' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_utilization_ratio" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" = 'vm''1' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'usedBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_usage_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'used' AND "host_name" = 'vm''1' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'freeBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "mountpoint" AS k, max("greptime_value") AS v FROM "system_filesystem_usage_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'free' AND "host_name" = 'vm''1' AND "mountpoint" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 151"`;

exports[`metric catalog SQL table jobTypes matches the snapshot without and with filters 1`] = `"SELECT 'pending' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_queue_depth" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "status" = 'pending' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'running' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_queue_depth" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "status" = 'running' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'oldestPendingSeconds' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_oldest_pending_age_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'succeeded' AS m, k, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "app_instance_id", "executor", "host_name", "job", "job_type", "outcome", "service_name" ORDER BY "greptime_timestamp") AS p FROM "app_jobs_settled_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "outcome" = 'succeeded' AND "job_type" IS NOT NULL) GROUP BY k UNION ALL SELECT 'failed' AS m, k, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "app_instance_id", "executor", "host_name", "job", "job_type", "outcome", "service_name" ORDER BY "greptime_timestamp") AS p FROM "app_jobs_settled_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "outcome" = 'failed' AND "job_type" IS NOT NULL) GROUP BY k ORDER BY k, m LIMIT 251"`;

exports[`metric catalog SQL table jobTypes matches the snapshot without and with filters 2`] = `"SELECT 'pending' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_queue_depth" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "status" = 'pending' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'running' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_queue_depth" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "status" = 'running' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'oldestPendingSeconds' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, max("greptime_value") AS v FROM "app_jobs_oldest_pending_age_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "job_type" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'succeeded' AS m, k, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "app_instance_id", "executor", "host_name", "job", "job_type", "outcome", "service_name" ORDER BY "greptime_timestamp") AS p FROM "app_jobs_settled_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "outcome" = 'succeeded' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "job_type" IS NOT NULL) GROUP BY k UNION ALL SELECT 'failed' AS m, k, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "app_instance_id", "executor", "host_name", "job", "job_type", "outcome", "service_name" ORDER BY "greptime_timestamp") AS p FROM "app_jobs_settled_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "outcome" = 'failed' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "job_type" IS NOT NULL) GROUP BY k ORDER BY k, m LIMIT 251"`;

exports[`metric catalog SQL table largestTables matches the snapshot without and with filters 1`] = `"SELECT 'sizeBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "postgresql_table_name" AS k, max("greptime_value") AS v FROM "postgresql_table_size_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "postgresql_table_name" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY v DESC, k LIMIT 501"`;

