e_value") AS v FROM "app_nodes_state_dir_free_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'stateDirTotalBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_state_dir_total_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'slotsUsed' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_slots_used" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'slotsTotal' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_slots_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 401"`;

exports[`metric catalog SQL table scrapeTargets matches the snapshot without and with filters 1`] = `"SELECT 'up' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "job" AS k, min("greptime_value") AS v FROM "up" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "job" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 51"`;

