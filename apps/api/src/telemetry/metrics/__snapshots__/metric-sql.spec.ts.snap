exports[`metric catalog SQL family jobDurationP95 matches the snapshot with the request filters 1`] = `"SELECT CASE WHEN ts >= '2026-09-27T21:00:00.000Z' THEN 'current' ELSE 'previous' END AS period, k AS g, le, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, "le" AS le, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "app_instance_id", "executor", "host_name", "job", "job_type", "le", "outcome", "service_name" ORDER BY "greptime_timestamp") AS p FROM "app_jobs_duration_seconds_bucket" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1') GROUP BY period, g, le ORDER BY period, g, le LIMIT 4001"`;

exports[`metric catalog SQL family jobDurationP95 matches the snapshot without filters 1`] = `"SELECT CASE WHEN ts >= '2026-09-27T21:00:00.000Z' THEN 'current' ELSE 'previous' END AS period, k AS g, le, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v FROM (SELECT "greptime_timestamp" AS ts, "job_type" AS k, "le" AS le, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "app_instance_id", "executor", "host_name", "job", "job_type", "le", "outcome", "service_name" ORDER BY "greptime_timestamp") AS p FROM "app_jobs_duration_seconds_bucket" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z') GROUP BY period, g, le ORDER BY period, g, le LIMIT 4001"`;

