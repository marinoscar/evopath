exports[`metric catalog SQL table nodes matches the snapshot without and with filters 1`] = `"SELECT 'cpuCores' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_cpu_utilization" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'rssBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_memory_rss_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'heapUsedBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_heap_used_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'heapLimitBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_heap_limit_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'stateDirFreeBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_state_dir_free_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'stateDirTotalBytes' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_state_dir_total_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'slotsUsed' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_slots_used" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k UNION ALL SELECT 'slotsTotal' AS m, k, last_value(v ORDER BY ts) AS v, max(ts) AS at FROM (SELECT "greptime_timestamp" AS ts, "node_name" AS k, max("greptime_value") AS v FROM "app_nodes_slots_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "node_name" IS NOT NULL GROUP BY ts, k) GROUP BY k ORDER BY k, m LIMIT 401"`;

