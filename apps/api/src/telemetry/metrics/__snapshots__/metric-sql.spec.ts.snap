// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`metric catalog SQL distinct hosts matches the snapshot 1`] = `"SELECT "host_name" AS v FROM "system_cpu_load_average_1m" WHERE "greptime_timestamp" >= '2026-09-27T21:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" IS NOT NULL AND "host_name" <> '' GROUP BY v ORDER BY v LIMIT 201"`;

exports[`metric catalog SQL family backupAge matches the snapshot with the request filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, k AS g, max(v) AS v FROM (SELECT "greptime_timestamp" AS ts, '' AS k, max("greptime_value") AS v FROM "app_backup_last_success_timestamp_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "app_instance_id" = 'inst-1' GROUP BY ts, k) GROUP BY t, g ORDER BY g, t LIMIT 2441"`;

exports[`metric catalog SQL family backupAge matches the snapshot without filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, k AS g, max(v) AS v FROM (SELECT "greptime_timestamp" AS ts, '' AS k, max("greptime_value") AS v FROM "app_backup_last_success_timestamp_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY ts, k) GROUP BY t, g ORDER BY g, t LIMIT 2441"`;

exports[`metric catalog SQL family cpuUtilization matches the snapshot with the request filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, k AS g, avg(v) AS v FROM (SELECT "greptime_timestamp" AS ts, '' AS k, avg(1 - "greptime_value") AS v FROM "system_cpu_utilization_ratio" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'idle' AND "host_name" = 'vm''1' GROUP BY ts, k) GROUP BY t, g ORDER BY g, t LIMIT 2441"`;

exports[`metric catalog SQL family cpuUtilization matches the snapshot without filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, k AS g, avg(v) AS v FROM (SELECT "greptime_timestamp" AS ts, '' AS k, avg(1 - "greptime_value") AS v FROM "system_cpu_utilization_ratio" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "state" = 'idle' GROUP BY ts, k) GROUP BY t, g ORDER BY g, t LIMIT 2441"`;

exports[`metric catalog SQL family dbBlocksHit matches the snapshot with the request filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, k AS g, sum(CASE WHEN p IS NULL THEN 0 WHEN v >= p THEN v - p ELSE v END) AS v FROM (SELECT "greptime_timestamp" AS ts, '' AS k, "greptime_value" AS v, lag("greptime_value") OVER (PARTITION BY "host_name", "instance", "postgresql_database_name", "service_instance_id" ORDER BY "greptime_timestamp") AS p FROM "postgresql_blks_hit_total" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND "host_name" = 'vm''1') GROUP BY t, g ORDER BY g, t LIMIT 2441"`;

