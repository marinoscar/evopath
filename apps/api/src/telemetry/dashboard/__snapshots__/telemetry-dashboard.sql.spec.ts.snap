exports[`telemetry dashboard SQL templates snapshots events with every option 1`] = `"SELECT CAST("timestamp" AS STRING) AS ts, severity_number, severity_text, json_get_string(resource_attributes, '["service.name"]') AS service, body, trace_id, span_id FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') = 'my-app-api' AND json_get_string(resource_attributes, '["app.instance.id"]') = 'node-1' AND (severity_number >= 17 OR (severity_number >= 13 AND severity_number < 17) OR (severity_number >= 9 AND severity_number < 13)) AND body ILIKE '%timeout%' ESCAPE '\\' AND ("timestamp" < '2026-09-27T21:59:59.123456789Z' OR ("timestamp" = '2026-09-27T21:59:59.123456789Z' AND span_id < 'abcdef0123456789')) ORDER BY "timestamp" DESC, span_id DESC LIMIT 51"`;

exports[`telemetry dashboard SQL templates snapshots the distinct-value statements 1`] = `"SELECT "service_name" AS v FROM "opentelemetry_traces" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" IS NOT NULL AND "service_name" <> '' UNION SELECT json_get_string(resource_attributes, '["service.name"]') AS v FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') IS NOT NULL AND json_get_string(resource_attributes, '["service.name"]') <> '' ORDER BY v LIMIT 201"`;

exports[`telemetry dashboard SQL templates snapshots the distinct-value statements 2`] = `"SELECT "resource_attributes.app.instance.id" AS v FROM "opentelemetry_traces" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND "resource_attributes.app.instance.id" IS NOT NULL AND "resource_attributes.app.instance.id" <> '' UNION SELECT json_get_string(resource_attributes, '["app.instance.id"]') AS v FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["app.instance.id"]') IS NOT NULL AND json_get_string(resource_attributes, '["app.instance.id"]') <> '' ORDER BY v LIMIT 201"`;

exports[`telemetry dashboard SQL templates topErrors matches the snapshot with service and instance filters 1`] = `"SELECT substr(body, 1, 200) AS message, count(*) AS occurrences, min("timestamp") AS first_seen, max("timestamp") AS last_seen, max(trace_id) AS sample_trace_id, max(json_get_string(resource_attributes, '["service.name"]')) AS service FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') = 'my-app-api' AND json_get_string(resource_attributes, '["app.instance.id"]') = 'node-1' AND severity_number >= 17 GROUP BY message ORDER BY occurrences DESC, last_seen DESC LIMIT 11"`;

exports[`telemetry dashboard SQL templates topErrors matches the snapshot without filters 1`] = `"SELECT substr(body, 1, 200) AS message, count(*) AS occurrences, min("timestamp") AS first_seen, max("timestamp") AS last_seen, max(trace_id) AS sample_trace_id, max(json_get_string(resource_attributes, '["service.name"]')) AS service FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND severity_number >= 17 GROUP BY message ORDER BY occurrences DESC, last_seen DESC LIMIT 11"`;

exports[`telemetry dashboard SQL templates topRoutes matches the snapshot with service and instance filters 1`] = `"SELECT "span_attributes.http.request.method" AS method, regexp_replace("span_attributes.url.path", '/([0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}|[0-9a-fA-F]{24,})(/|$)', '/:id$2', 'g') AS route, count(*) AS requests, sum(CASE WHEN "span_attributes.http.response.status_code" >= 500 THEN 1 ELSE 0 END) AS errors, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY "duration_nano") AS p95_ns FROM "opentelemetry_traces" WHERE "span_kind" = 'SPAN_KIND_SERVER' AND "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "resource_attributes.app.instance.id" = 'node-1' GROUP BY method, route ORDER BY errors DESC, p95_ns DESC LIMIT 11"`;

exports[`telemetry dashboard SQL templates topRoutes matches the snapshot without filters 1`] = `"SELECT "span_attributes.http.request.method" AS method, regexp_replace("span_attributes.url.path", '/([0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,}|[0-9a-fA-F]{24,})(/|$)', '/:id$2', 'g') AS route, count(*) AS requests, sum(CASE WHEN "span_attributes.http.response.status_code" >= 500 THEN 1 ELSE 0 END) AS errors, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY "duration_nano") AS p95_ns FROM "opentelemetry_traces" WHERE "span_kind" = 'SPAN_KIND_SERVER' AND "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY method, route ORDER BY errors DESC, p95_ns DESC LIMIT 11"`;
