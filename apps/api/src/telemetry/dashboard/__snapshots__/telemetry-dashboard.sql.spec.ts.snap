// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`telemetry dashboard SQL templates apiTimeseries matches the snapshot with service and instance filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', "timestamp") AS t, count(*) AS total, sum(CASE WHEN "span_attributes.http.response.status_code" >= 200 AND "span_attributes.http.response.status_code" < 300 THEN 1 ELSE 0 END) AS s2xx, sum(CASE WHEN "span_attributes.http.response.status_code" >= 300 AND "span_attributes.http.response.status_code" < 400 THEN 1 ELSE 0 END) AS s3xx, sum(CASE WHEN "span_attributes.http.response.status_code" >= 400 AND "span_attributes.http.response.status_code" < 500 THEN 1 ELSE 0 END) AS s4xx, sum(CASE WHEN "span_attributes.http.response.status_code" >= 500 THEN 1 ELSE 0 END) AS s5xx, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY CASE WHEN "span_attributes.url.path" LIKE '%/stream' THEN NULL ELSE "duration_nano" END) AS p95_ns FROM "opentelemetry_traces" WHERE "span_kind" = 'SPAN_KIND_SERVER' AND "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "resource_attributes.app.instance.id" = 'node-1' GROUP BY t ORDER BY t LIMIT 62"`;

exports[`telemetry dashboard SQL templates apiTimeseries matches the snapshot without filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', "timestamp") AS t, count(*) AS total, sum(CASE WHEN "span_attributes.http.response.status_code" >= 200 AND "span_attributes.http.response.status_code" < 300 THEN 1 ELSE 0 END) AS s2xx, sum(CASE WHEN "span_attributes.http.response.status_code" >= 300 AND "span_attributes.http.response.status_code" < 400 THEN 1 ELSE 0 END) AS s3xx, sum(CASE WHEN "span_attributes.http.response.status_code" >= 400 AND "span_attributes.http.response.status_code" < 500 THEN 1 ELSE 0 END) AS s4xx, sum(CASE WHEN "span_attributes.http.response.status_code" >= 500 THEN 1 ELSE 0 END) AS s5xx, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY CASE WHEN "span_attributes.url.path" LIKE '%/stream' THEN NULL ELSE "duration_nano" END) AS p95_ns FROM "opentelemetry_traces" WHERE "span_kind" = 'SPAN_KIND_SERVER' AND "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY t ORDER BY t LIMIT 62"`;

exports[`telemetry dashboard SQL templates apiTotals matches the snapshot with service and instance filters 1`] = `"SELECT CASE WHEN "timestamp" >= '2026-09-27T21:00:00.000Z' THEN 'current' ELSE 'previous' END AS period, count(*) AS requests, sum(CASE WHEN "span_attributes.http.response.status_code" >= 500 THEN 1 ELSE 0 END) AS errors, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY CASE WHEN "span_attributes.url.path" LIKE '%/stream' THEN NULL ELSE "duration_nano" END) AS p95_ns FROM "opentelemetry_traces" WHERE "span_kind" = 'SPAN_KIND_SERVER' AND "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "resource_attributes.app.instance.id" = 'node-1' GROUP BY period ORDER BY period LIMIT 2"`;

exports[`telemetry dashboard SQL templates apiTotals matches the snapshot without filters 1`] = `"SELECT CASE WHEN "timestamp" >= '2026-09-27T21:00:00.000Z' THEN 'current' ELSE 'previous' END AS period, count(*) AS requests, sum(CASE WHEN "span_attributes.http.response.status_code" >= 500 THEN 1 ELSE 0 END) AS errors, approx_percentile_cont(0.95) WITHIN GROUP (ORDER BY CASE WHEN "span_attributes.url.path" LIKE '%/stream' THEN NULL ELSE "duration_nano" END) AS p95_ns FROM "opentelemetry_traces" WHERE "span_kind" = 'SPAN_KIND_SERVER' AND "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY period ORDER BY period LIMIT 2"`;

exports[`telemetry dashboard SQL templates eventLoopDelayP99 matches the snapshot with service and instance filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', greptime_timestamp) AS t, max(greptime_value) * 1000 AS v FROM "nodejs_eventloop_delay_p99_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND service_name = 'my-app-api' GROUP BY t ORDER BY t LIMIT 122"`;

exports[`telemetry dashboard SQL templates eventLoopDelayP99 matches the snapshot without filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', greptime_timestamp) AS t, max(greptime_value) * 1000 AS v FROM "nodejs_eventloop_delay_p99_seconds" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY t ORDER BY t LIMIT 122"`;

exports[`telemetry dashboard SQL templates events matches the snapshot with service and instance filters 1`] = `"SELECT CAST("timestamp" AS STRING) AS ts, severity_number, severity_text, json_get_string(resource_attributes, '["service.name"]') AS service, body, trace_id, span_id FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') = 'my-app-api' AND json_get_string(resource_attributes, '["app.instance.id"]') = 'node-1' AND (severity_number >= 17 OR (severity_number >= 13 AND severity_number < 17)) ORDER BY "timestamp" DESC, span_id DESC LIMIT 51"`;

exports[`telemetry dashboard SQL templates events matches the snapshot without filters 1`] = `"SELECT CAST("timestamp" AS STRING) AS ts, severity_number, severity_text, json_get_string(resource_attributes, '["service.name"]') AS service, body, trace_id, span_id FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND (severity_number >= 17 OR (severity_number >= 13 AND severity_number < 17)) ORDER BY "timestamp" DESC, span_id DESC LIMIT 51"`;

exports[`telemetry dashboard SQL templates heapUsed matches the snapshot with service and instance filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, avg(total) AS v FROM (SELECT greptime_timestamp AS ts, sum(greptime_value) AS total FROM "v8js_memory_heap_used_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' AND service_name = 'my-app-api' GROUP BY greptime_timestamp) GROUP BY t ORDER BY t LIMIT 122"`;

exports[`telemetry dashboard SQL templates heapUsed matches the snapshot without filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', ts) AS t, avg(total) AS v FROM (SELECT greptime_timestamp AS ts, sum(greptime_value) AS total FROM "v8js_memory_heap_used_bytes" WHERE "greptime_timestamp" >= '2026-09-27T20:00:00.000Z' AND "greptime_timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY greptime_timestamp) GROUP BY t ORDER BY t LIMIT 122"`;

exports[`telemetry dashboard SQL templates lastData matches the snapshot with service and instance filters 1`] = `"SELECT (SELECT max("timestamp") FROM "opentelemetry_traces" WHERE "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND "service_name" = 'my-app-api' AND "resource_attributes.app.instance.id" = 'node-1') AS traces_last, (SELECT max("timestamp") FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') = 'my-app-api' AND json_get_string(resource_attributes, '["app.instance.id"]') = 'node-1') AS logs_last LIMIT 1"`;

exports[`telemetry dashboard SQL templates lastData matches the snapshot without filters 1`] = `"SELECT (SELECT max("timestamp") FROM "opentelemetry_traces" WHERE "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z') AS traces_last, (SELECT max("timestamp") FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z') AS logs_last LIMIT 1"`;

exports[`telemetry dashboard SQL templates logsTimeseries matches the snapshot with service and instance filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', "timestamp") AS t, sum(CASE WHEN severity_number >= 17 THEN 1 ELSE 0 END) AS error, sum(CASE WHEN (severity_number >= 13 AND severity_number < 17) THEN 1 ELSE 0 END) AS warn, sum(CASE WHEN (severity_number >= 9 AND severity_number < 13) THEN 1 ELSE 0 END) AS info, sum(CASE WHEN (severity_number IS NULL OR severity_number < 9) THEN 1 ELSE 0 END) AS other FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') = 'my-app-api' AND json_get_string(resource_attributes, '["app.instance.id"]') = 'node-1' GROUP BY t ORDER BY t LIMIT 62"`;

exports[`telemetry dashboard SQL templates logsTimeseries matches the snapshot without filters 1`] = `"SELECT date_bin(INTERVAL '60 seconds', "timestamp") AS t, sum(CASE WHEN severity_number >= 17 THEN 1 ELSE 0 END) AS error, sum(CASE WHEN (severity_number >= 13 AND severity_number < 17) THEN 1 ELSE 0 END) AS warn, sum(CASE WHEN (severity_number >= 9 AND severity_number < 13) THEN 1 ELSE 0 END) AS info, sum(CASE WHEN (severity_number IS NULL OR severity_number < 9) THEN 1 ELSE 0 END) AS other FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T21:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' GROUP BY t ORDER BY t LIMIT 62"`;

exports[`telemetry dashboard SQL templates logsTotals matches the snapshot with service and instance filters 1`] = `"SELECT CASE WHEN "timestamp" >= '2026-09-27T21:00:00.000Z' THEN 'current' ELSE 'previous' END AS period, sum(CASE WHEN severity_number >= 17 THEN 1 ELSE 0 END) AS error, sum(CASE WHEN (severity_number >= 13 AND severity_number < 17) THEN 1 ELSE 0 END) AS warn FROM "opentelemetry_logs" WHERE "timestamp" >= '2026-09-27T20:00:00.000Z' AND "timestamp" < '2026-09-27T22:00:00.000Z' AND json_get_string(resource_attributes, '["service.name"]') = 'my-app-api' AND json_get_string(resource_attributes, '["app.instance.id"]') = 'node-1' GROUP BY period ORDER BY period LIMIT 2"`;

