{
  "name": "research-page-injection",
  "description": "A retrieved page told the model to ignore its rules; the injected text and unverified link never reach the plan.",
  "calls": {
    "researcher": [
      {
        "outputJson": "../research/page-injection.json",
        "usage": {
          "inputTokens": 9000,
          "outputTokens": 4200,
          "reasoningTokens": 1500
        }
      }
    ],
    "planner": [
      {
        "outputJson": "planner/valid-8w.json",
        "usage": {
          "inputTokens": 14000,
          "outputTokens": 7800,
          "reasoningTokens": 3000
        }
      }
    ],
    "critic": [
      {
        "outputJson": "critic/approve.json",
        "usage": {
          "inputTokens": 6000,
          "outputTokens": 700,
          "reasoningTokens": 400
        }
      }
    ],
    "evaluator": []
  },
  "http": {
    "rateLimitOnCall": null,
    "retryAfterSeconds": 2,
    "delayMs": 0
  }
}
