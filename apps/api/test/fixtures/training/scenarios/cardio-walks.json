{
  "name": "cardio-walks",
  "description": "Three strength days plus four 30-minute walks were asked for: the planner puts the walks on the four non-strength days and the critic approves.",
  "calls": {
    "researcher": [
      {
        "outputJson": "../research/valid.json",
        "usage": {
          "inputTokens": 9000,
          "outputTokens": 4200,
          "reasoningTokens": 1500
        }
      }
    ],
    "planner": [
      {
        "outputJson": "planner/cardio-walks-8w.json",
        "usage": {
          "inputTokens": 14000,
          "outputTokens": 7800,
          "reasoningTokens": 3000
        }
      }
    ],
    "critic": [
      {
        "outputJson": "critic/approve.json",
        "usage": {
          "inputTokens": 6000,
          "outputTokens": 700,
          "reasoningTokens": 400
        }
      }
    ],
    "evaluator": []
  },
  "http": {
    "rateLimitOnCall": null,
    "retryAfterSeconds": 2,
    "delayMs": 0
  }
}
