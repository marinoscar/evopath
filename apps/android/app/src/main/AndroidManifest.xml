<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Web Push delegated from the PWA through the TWA, and (later) sync notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect: read-only. Types are switchable per type in Health sync. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <!-- Requested only when Health Connect supports it (HealthConnectFeatures). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <queries>
        <!-- Lets androidbrowserhelper find a browser that supports Custom Tabs / TWAs. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Health Connect (Android 13 and below ship it as an app). -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Common Health Connect sources, to show their names (see healthconnect/SourceApps.kt). -->
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.ouraring.oura" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.google.android.apps.wearables.maestro.companion" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="com.strava" />
        <package android:name="fi.polar.polarflow" />
        <package android:name="com.huawei.health" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.hm.health" />
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.whoop.android" />
        <package android:name="com.myfitnesspal.android" />
    </queries>

    <application
        android:name=".MobileApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        tools:targetApi="36">

        <!-- Trusted Web Activity launcher: opens ${server}/?source=twa, or the setup screen when no server is set.
             Started directly by the app's own screens; the launcher icon goes through the alias below. -->
        <activity
            android:name=".TwaLauncherActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Launcher">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/twa_default_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/brand_primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/brand_background" />
        </activity>

        <!-- The launcher entry. Its component name is ${applicationId}.TwaLauncherActivity, the name the
             launcher icon has always had, so home-screen icons survive an update that moves the Kotlin
             package (launchers drop icons whose component disappears). -->
        <activity-alias
            android:name="${applicationId}.TwaLauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity=".TwaLauncherActivity">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/twa_default_url" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/brand_primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/brand_background" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/brand_primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/brand_background" />
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".setup.SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".healthsync.HealthSyncActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/shortcut_health_sync_short"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${deepLinkScheme}"
                    android:host="health-sync" />
            </intent-filter>
        </activity>

        <!-- Health Connect privacy rationale (Android 13 and below: from the permission screen). -->
        <activity
            android:name=".healthconnect.PermissionsRationaleActivity"
            android:exported="true"
            android:label="@string/health_rationale_title">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: the same screen from Settings → permission usage. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".healthconnect.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Lets the PWA's notifications and other trusted features be delegated to this app. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
