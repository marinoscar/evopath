<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand colours (brand_primary, brand_background) and app_name are generated from packages/shared/identity.json by app/build.gradle.kts. -->
    <!-- Native (Compose) screens. Compose draws its own Material 3 surfaces on top. -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
    </style>

    <!-- The TWA launcher only hands off to the browser (or the setup screen), so it draws nothing. -->
    <style name="Theme.App.Launcher" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:statusBarColor">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
    </style>

    <!-- Activities that only show a system dialog (the TWA notification-permission request). -->
    <style name="Theme.App.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
